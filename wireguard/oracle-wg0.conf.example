# WireGuard server config — Oracle Cloud VM
# Path: /etc/wireguard/wg0.conf
#
# Replace ALL placeholders before use:
#   <ORACLE_PRIVATE_KEY>   — output of `wg genkey` on this machine
#   <LOCAL_SERVER_PUBKEY>  — output of `wg pubkey` on the local server
#   <ORACLE_NETWORK_IFACE> — your main NIC name (ens3, enp0s3, eth0...)

[Interface]
PrivateKey = <ORACLE_PRIVATE_KEY>
Address = 10.0.0.1/24
ListenPort = 51820
PostUp   = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o <ORACLE_NETWORK_IFACE> -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o <ORACLE_NETWORK_IFACE> -j MASQUERADE

[Peer]
# Local server (behind CGNAT)
PublicKey  = <LOCAL_SERVER_PUBKEY>
AllowedIPs = 10.0.0.2/32
