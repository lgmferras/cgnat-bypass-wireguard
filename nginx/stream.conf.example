# Nginx stream (TCP proxy) config — Oracle Cloud VM
# Path: /etc/nginx/stream.d/cgnat-bypass.conf
#
# Requires the nginx stream module (nginx-full package on Ubuntu/Debian).
# Include this file from the main nginx.conf:
#
#   stream {
#       include /etc/nginx/stream.d/*.conf;
#   }
#
# 10.0.0.2 is the WireGuard IP of the local server.
# proxy_protocol on — sends the real client IP to the local server via PROXY Protocol.
# The local Nginx must be configured to accept PROXY Protocol (see nginx/local-nginx.conf.example).

server {
    listen 80;
    proxy_pass 10.0.0.2:80;
    proxy_protocol on;
}

server {
    listen 443;
    proxy_pass 10.0.0.2:443;
    proxy_protocol on;
}

# Add more servers as needed, e.g. for custom ports:
# server {
#     listen 8443;
#     proxy_pass 10.0.0.2:8443;
#     proxy_protocol on;
# }
